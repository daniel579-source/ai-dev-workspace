<Window x:Class="LogTrace.App.LayoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LogTrace.App"
        Title="{Binding Title}" Width="1280" Height="860" Activated="Window_Activated" PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.AutomationId="LayoutEditor">
    <!-- ADR-0006 第 9 點：三欄式——左邊廠別設定、工具箱與元素清單，中間畫布，右邊屬性 -->
    <Window.Resources>
        <local:ElementTypeLabelConverter x:Key="TypeLabel" />
        <local:FileNameConverter x:Key="FileName" />
        <local:CollapsedWhenTrueConverter x:Key="Collapsed" />
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- 輸送線起點、終點選單的項目：類型＋名稱（和元素清單一樣） -->
        <DataTemplate x:Key="EndpointItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TypeLabel}" Foreground="#777" Width="56" />
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="Width" Value="76" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#555" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- 檔案 -->
        <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增設定" Command="{Binding NewCommand}" Padding="10,2" AutomationProperties.AutomationId="NewConfig" />
                <Button Content="開啟其他檔案…" Command="{Binding OpenFileCommand}" Padding="10,2" Margin="6,0,0,0" AutomationProperties.AutomationId="OpenConfigFile" />
                <Button Content="存檔" Command="{Binding SaveCommand}" Padding="14,2" Margin="16,0,0,0" FontWeight="SemiBold" AutomationProperties.AutomationId="SaveConfig" />
                <Button Content="另存新檔…" Command="{Binding SaveAsCommand}" Padding="10,2" Margin="6,0,0,0" AutomationProperties.AutomationId="SaveConfigAs" />
                <TextBlock Text="廠別" VerticalAlignment="Center" Margin="24,0,6,0" />
                <TextBox Text="{Binding PlantName, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.AutomationId="PlantName" />
                <TextBlock Text="儲位規則" VerticalAlignment="Center" Margin="16,0,6,0"
                           ToolTip="R＝排、C＝列、L＝層，字數就是位數。例如 RRCCCLL 會把 0100802 拆成排 01、列 008、層 02。" />
                <TextBox Text="{Binding StorageCodeRule, UpdateSourceTrigger=PropertyChanged}" Width="100" AutomationProperties.AutomationId="StorageCodeRule" />
                <TextBlock Text="{Binding RevisionInfo}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#777" AutomationProperties.AutomationId="RevisionInfo" />
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="EditorStatus" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 左：廠別設定、工具箱、元素清單 -->
            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="廠別設定" FontWeight="SemiBold" />
                <ListBox x:Name="ConfigList" DockPanel.Dock="Top" ItemsSource="{Binding Configs}" Height="110" Margin="0,4,0,0"
                         AutomationProperties.AutomationId="ConfigList" MouseDoubleClick="ConfigList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FileName}}" ToolTip="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button DockPanel.Dock="Top" Content="開啟選取的設定" Command="{Binding OpenConfigCommand}" CommandParameter="{Binding SelectedItem, ElementName=ConfigList}"
                        HorizontalAlignment="Left" Padding="8,1" Margin="0,4,0,0" AutomationProperties.AutomationId="OpenSelectedConfig" />

                <TextBlock DockPanel.Dock="Top" Text="新增元素" FontWeight="SemiBold" Margin="0,12,0,4" />
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding AddableTypes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Converter={StaticResource TypeLabel}}" Padding="8,2" Margin="0,0,4,4"
                                    Command="{Binding DataContext.AddElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding StringFormat=Add_{0}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 導軌的範本（ADR-0006 第 14 點）：「導軌」按鈕是直線，這個是跑道形環 -->
                <Button DockPanel.Dock="Top" Content="導軌（跑道形）" Command="{Binding AddRailLoopCommand}" HorizontalAlignment="Left" Padding="8,2"
                        AutomationProperties.AutomationId="Add_RailLoop" />

                <TextBlock DockPanel.Dock="Top" Text="元素清單" FontWeight="SemiBold" Margin="0,8,0,4" />
                <ListBox ItemsSource="{Binding ElementList}" SelectedItem="{Binding SelectedElement}" AutomationProperties.AutomationId="ElementList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TypeLabel}" Foreground="#777" Width="56" />
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding AliasesText, StringFormat=（{0}）, TargetNullValue=''}" Foreground="#2A6CB0" Margin="4,0,0,0" />
                                <TextBlock Text="{Binding Floor}" Foreground="#999" Margin="6,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 中：3D 畫布（吸附 0.5 公尺，ADR-0018）；下方是未對應的編號（ADR-0006 第 3、9 點） -->
            <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Height="170" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="8,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="未對應的編號" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="　比對案件" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#555" />
                        <ComboBox ItemsSource="{Binding CaseChoices}" SelectedItem="{Binding SelectedCompareCase}" DisplayMemberPath="Name" Width="200"
                                  AutomationProperties.AutomationId="CompareCase" />
                        <Button Content="載入案件比對" Command="{Binding LoadCaseCompareCommand}" Padding="8,1" Margin="6,0,0,0"
                                AutomationProperties.AutomationId="LoadCaseCompare" />
                        <TextBlock Text="{Binding CompareCaseName, StringFormat=目前比對：{0}, TargetNullValue=''}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#777" />
                        <Button Content="設為選取元素的別名" Command="{Binding AssignSelectedUnmappedCommand}" Padding="8,1" Margin="12,0,0,0"
                                AutomationProperties.AutomationId="AssignUnmapped" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="案件 LOG 中出現、但還沒有元素以它為別名的編號。先在 3D 畫布上選取站點、搬送機、對接設備、防火門或電梯，再雙擊編號（或選編號後按「設為選取元素的別名」），即可加為別名。"
                               Foreground="#777" Margin="0,4,0,4" TextWrapping="Wrap" />
                    <ListBox x:Name="UnmappedList" ItemsSource="{Binding Unmapped}" SelectedItem="{Binding SelectedUnmapped}" AutomationProperties.AutomationId="UnmappedList"
                             MouseDoubleClick="Unmapped_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FEF3C7" CornerRadius="3" Padding="6,2" Cursor="Hand" ToolTip="雙擊：設為選取元素的別名">
                                    <TextBlock>
                                        <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="　" /><Run Text="{Binding KindLabel, Mode=OneWay}" Foreground="#777" /><Run Text="　" /><Run Text="{Binding Count, Mode=OneWay, StringFormat={}{0} 次}" Foreground="#777" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <!-- 樓層列（ADR-0006 第 13 點）：切換樓層、新增、改名、上移、下移、刪除、樓板高度，以及只顯示目前樓層（ADR-0018） -->
            <Border DockPanel.Dock="Top" Padding="6,3" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                <WrapPanel>
                    <TextBlock Text="樓層" VerticalAlignment="Center" Foreground="#555" Margin="0,0,6,0" />
                    <ListBox ItemsSource="{Binding Floors}" SelectedItem="{Binding CurrentFloor}" BorderThickness="0" Background="Transparent"
                             AutomationProperties.AutomationId="FloorTabs">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Padding="8,1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="＋ 新增樓層" Command="{Binding AddFloorCommand}" Padding="6,1" Margin="6,0,0,0" AutomationProperties.AutomationId="AddFloor" />
                    <TextBox Text="{Binding FloorNameText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="12,0,0,0" AutomationProperties.AutomationId="FloorName">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding RenameFloorCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="改名" Command="{Binding RenameFloorCommand}" Padding="6,1" Margin="4,0,0,0" AutomationProperties.AutomationId="RenameFloor" />
                    <Button Content="上移" Command="{Binding MoveFloorUpCommand}" Padding="6,1" Margin="4,0,0,0" ToolTip="往較高的樓層移動" />
                    <Button Content="下移" Command="{Binding MoveFloorDownCommand}" Padding="6,1" Margin="4,0,0,0" ToolTip="往較低的樓層移動" />
                    <Button Content="刪除樓層" Command="{Binding DeleteFloorCommand}" Padding="6,1" Margin="4,0,0,0" AutomationProperties.AutomationId="DeleteFloor" />
                    <!-- 樓板高度（ADR-0017 第 6 點）：3D 回放上下堆疊樓層時使用；空白＝預設 5 公尺 -->
                    <TextBlock Text="樓板高度" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="#555" />
                    <TextBox Text="{Binding FloorHeightText, UpdateSourceTrigger=PropertyChanged}" Width="50" AutomationProperties.AutomationId="FloorHeight"
                             ToolTip="目前樓層的樓板高度（公尺），3D 回放上下堆疊樓層時使用；空白＝預設 5 公尺">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SetFloorHeightCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="公尺" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="#555" />
                    <Button Content="套用" Command="{Binding SetFloorHeightCommand}" Padding="6,1" Margin="4,0,0,0" AutomationProperties.AutomationId="SetFloorHeight" />
                    <CheckBox Content="只顯示目前樓層" IsChecked="{Binding OnlyCurrentFloor}" VerticalAlignment="Center" Margin="16,0,0,0"
                              ToolTip="3D 中只畫目前樓層，避免上層遮擋（ADR-0018）" AutomationProperties.AutomationId="EditorOnlyCurrentFloor" />
                </WrapPanel>
            </Border>
            <!-- 3D 畫布（ADR-0018）：WebView2 + three.js；編輯邏輯在 ViewModel，網頁回報目前樓層平面上的座標 -->
            <local:Layout3DEditorView x:Name="Editor3D" />
            </DockPanel>

            <!-- 右：元素屬性與 LOG 設定 -->
            <TabControl Grid.Column="2" Margin="0,4,4,4">
            <TabItem Header="元素屬性" AutomationProperties.AutomationId="ElementTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" DataContext="{Binding SelectedElement}">
                    <TextBlock Text="{Binding DataContext.SelectionHint, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Foreground="#777"
                               AutomationProperties.AutomationId="SelectionHint">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding DataContext.HasMultipleSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                        <Button DockPanel.Dock="Right" Content="移過去" Padding="8,1" Margin="4,0,0,0"
                                Command="{Binding DataContext.MoveSelectionToFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="MoveSelectionToFloor" />
                        <TextBlock Text="移到樓層" Style="{StaticResource Field}" />
                        <ComboBox ItemsSource="{Binding DataContext.Floors, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DataContext.MoveTargetFloor, RelativeSource={RelativeSource AncestorType=Window}}"
                                  AutomationProperties.AutomationId="MoveTargetFloor" />
                    </DockPanel>
                    <StackPanel Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6">
                            <Run Text="{Binding TypeLabel, Mode=OneWay}" /><Run Text="　" /><Run Text="{Binding Id, Mode=OneWay}" Foreground="#777" />
                        </TextBlock>
                        <DockPanel>
                            <TextBlock Text="名稱" Style="{StaticResource Field}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementName" />
                        </DockPanel>

                        <!-- 輸送線 -->
                        <StackPanel Visibility="{Binding IsConveyor, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <TextBlock Text="起點" Style="{StaticResource Field}" />
                                <ComboBox ItemsSource="{Binding DataContext.ConveyorEndpoints, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Id" ItemTemplate="{StaticResource EndpointItem}" SelectedValue="{Binding From}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="終點" Style="{StaticResource Field}" />
                                <ComboBox ItemsSource="{Binding DataContext.ConveyorEndpoints, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Id" ItemTemplate="{StaticResource EndpointItem}" SelectedValue="{Binding To}" />
                            </DockPanel>
                            <CheckBox Content="雙向" IsChecked="{Binding Bidirectional}" Margin="0,4,0,0" AutomationProperties.AutomationId="ConveyorBidirectional" />
                            <TextBlock Text="{Binding TransferPointsText, StringFormat=交接點：{0}, TargetNullValue=''}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="輸送線表示貨物流向（單向為起點 → 終點），不和 LOG 對應，也不從 LOG 推導狀態。連到搬送機時，線畫到交接點，拖曳線端的橘點調整。" TextWrapping="Wrap" Foreground="#777" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 導軌（ADR-0006 第 14 點） -->
                        <StackPanel Visibility="{Binding IsRail, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <TextBlock Text="樓層" Style="{StaticResource Field}" />
                                <ComboBox ItemsSource="{Binding DataContext.Floors, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Floor}" />
                            </DockPanel>
                            <CheckBox Content="閉合（頭尾相接）" IsChecked="{Binding Closed}" Margin="0,4,0,0" AutomationProperties.AutomationId="RailClosed" />
                            <TextBlock Text="{Binding DataContext.RailSelectionText, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,0,2"
                                       AutomationProperties.AutomationId="RailSelection" />
                            <DockPanel>
                                <TextBlock Text="段" Style="{StaticResource Field}" />
                                <ComboBox ItemsSource="{Binding DataContext.RailSegments, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Index" DisplayMemberPath="Label"
                                          SelectedValue="{Binding DataContext.SelectedRailSegment, RelativeSource={RelativeSource AncestorType=Window}}"
                                          AutomationProperties.AutomationId="RailSegment" />
                            </DockPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="插入點" Command="{Binding DataContext.InsertRailPointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="8,1" Margin="0,0,4,4" ToolTip="在選取的段的中點插入一點" AutomationProperties.AutomationId="InsertRailPoint" />
                                <Button Content="刪除點" Command="{Binding DataContext.DeleteRailPointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="8,1" Margin="0,0,4,4" AutomationProperties.AutomationId="DeleteRailPoint" />
                                <Button Content="這段改直線" Command="{Binding DataContext.StraightenRailSegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="8,1" Margin="0,0,4,4" AutomationProperties.AutomationId="StraightenRailSegment" />
                                <Button Content="轉 90°" Command="{Binding DataContext.RotateClockwiseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="8,1" Margin="0,0,4,4" AutomationProperties.AutomationId="RotateRail" />
                            </WrapPanel>
                            <TextBlock Text="拖曳方形把手移動點，拖曳圓形把手（每段的中點）把直線變弧線、調整彎度（最多半圓）；雙擊導軌插入點；拖曳線條整條移動。導軌是輔助元素，不和 LOG 對應。" TextWrapping="Wrap" Foreground="#777" Margin="0,4,0,6" />
                        </StackPanel>

                        <!-- 搬送機所走的導軌（ADR-0006 第 14 點）：只列同一層的導軌 -->
                        <DockPanel Visibility="{Binding IsVehicle, Converter={StaticResource Visible}}">
                            <TextBlock Text="導軌" Style="{StaticResource Field}" />
                            <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Margin="4,0,0,0" ToolTip="清除導軌指定"
                                    Command="{Binding DataContext.ClearVehicleRailCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ComboBox ItemsSource="{Binding DataContext.RailChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" SelectedValue="{Binding Rail}" AutomationProperties.AutomationId="VehicleRail" />
                        </DockPanel>

                        <!-- 防火門（ADR-0006 第 1 點 2026-11-06 補充） -->
                        <StackPanel Visibility="{Binding IsFireDoor, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <TextBlock Text="平時狀態" Style="{StaticResource Field}" />
                                <ComboBox ItemsSource="{Binding DataContext.DoorStateChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedIndex="{Binding DoorStateIndex}" AutomationProperties.AutomationId="DoorState" />
                            </DockPanel>
                            <TextBlock Text="回放時還沒有 LOG 事件，就以平時狀態顯示，並標為「推估」；不設定時顯示「未取得資訊」。" TextWrapping="Wrap" Foreground="#777" Margin="0,2,0,6" />
                            <TextBlock Text="穿過這扇門的輸送線" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding DataContext.SelectedDoorConveyors, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,4,0,0"
                                          AutomationProperties.AutomationId="DoorConveyors">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,2">
                                            <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Margin="4,0,0,0" ToolTip="移除關聯"
                                                    Command="{Binding DataContext.RemoveDoorConveyorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,2,0,0">
                                <Button DockPanel.Dock="Right" Content="加入" Padding="8,1" Margin="4,0,0,0"
                                        Command="{Binding DataContext.AddDoorConveyorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.AutomationId="AddDoorConveyor" />
                                <ComboBox ItemsSource="{Binding DataContext.ConveyorChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding DataContext.NewDoorConveyor, RelativeSource={RelativeSource AncestorType=Window}}"
                                          AutomationProperties.AutomationId="NewDoorConveyor" />
                            </DockPanel>
                            <Button Content="依位置帶入" HorizontalAlignment="Left" Padding="8,1" Margin="0,4,0,0"
                                    ToolTip="把線段碰到這扇門範圍的輸送線加入關聯"
                                    Command="{Binding DataContext.SuggestDoorConveyorsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AutomationProperties.AutomationId="SuggestDoorConveyors" />
                            <TextBlock Text="門關上時（含推估），這些輸送線在回放時畫成阻斷；貨物在輸送線兩端之間移動時，在那一筆事件標示「不一致」。" TextWrapping="Wrap" Foreground="#777" Margin="0,4,0,6" />
                        </StackPanel>

                        <!-- 位置、尺寸、旋轉 -->
                        <StackPanel Visibility="{Binding HasGeometry, Converter={StaticResource Visible}}">
                            <DockPanel Visibility="{Binding IsElevator, Converter={StaticResource Collapsed}}">
                                <TextBlock Text="樓層" Style="{StaticResource Field}" />
                                <ComboBox ItemsSource="{Binding DataContext.Floors, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Floor}" AutomationProperties.AutomationId="ElementFloor" />
                            </DockPanel>
                            <!-- 電梯服務的樓層（ADR-0006 第 15 點） -->
                            <StackPanel Visibility="{Binding IsElevator, Converter={StaticResource Visible}}">
                                <TextBlock Text="服務的樓層（至少兩層）" FontWeight="SemiBold" Margin="0,2,0,2" />
                                <ItemsControl ItemsSource="{Binding DataContext.ServedFloorChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              AutomationProperties.AutomationId="ServedFloors">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Floor}" IsChecked="{Binding IsChecked}" Margin="0,0,10,2"
                                                      AutomationProperties.AutomationId="{Binding Floor, StringFormat=ServedFloor_{0}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="電梯在每個服務的樓層同一個位置畫出來，任何一層都可以拖曳；並排時拖到別層不會換樓層。輸送線不能接到電梯。" TextWrapping="Wrap" Foreground="#777" Margin="0,2,0,6" />
                            </StackPanel>
                            <DockPanel>
                                <TextBlock Text="x（m）" Style="{StaticResource Field}" />
                                <TextBox Text="{Binding X}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="y（m）" Style="{StaticResource Field}" />
                                <TextBox Text="{Binding Y}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="寬（m）" Style="{StaticResource Field}" />
                                <TextBox Text="{Binding W}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="深（m）" Style="{StaticResource Field}" />
                                <TextBox Text="{Binding H}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="旋轉" Style="{StaticResource Field}" />
                                <ItemsControl ItemsSource="{x:Static local:LayoutEditorWindow.Rotations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" ContentStringFormat="{}{0}°" Padding="6,1" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.SetRotationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="目前" Style="{StaticResource Field}" />
                                <TextBlock Text="{Binding Rotation, StringFormat={}{0} 度}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>

                        <!-- 高度：料架以層數 × 每層高度計算 -->
                        <DockPanel>
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRack}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConveyor}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <TextBlock Text="高度（m）" Style="{StaticResource Field}" />
                            <TextBox Text="{Binding Height}" />
                        </DockPanel>

                        <!-- 料架 -->
                        <StackPanel Visibility="{Binding IsRack, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <TextBlock Text="排" Style="{StaticResource Field}" />
                                <TextBox Text="{Binding Row, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="起始列" Style="{StaticResource Field}" />
                                <TextBox Text="{Binding ColFrom}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="結束列" Style="{StaticResource Field}" />
                                <TextBox Text="{Binding ColTo}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="層數" Style="{StaticResource Field}" />
                                <TextBox Text="{Binding Levels}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="每層高（m）" Style="{StaticResource Field}" />
                                <TextBox Text="{Binding LevelHeight}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="高度" Style="{StaticResource Field}" />
                                <TextBlock Text="{Binding RackHeight, StringFormat={}{0:0.0} m（層數 × 每層高）}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>

                        <!-- 別名 -->
                        <StackPanel Visibility="{Binding CanHaveAliases, Converter={StaticResource Visible}}" Margin="0,10,0,0">
                            <TextBlock Text="別名（LOG 中的編號，完全相同才算對應）" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Aliases}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#E0E7FF" CornerRadius="3" Padding="6,1,2,1" Margin="0,0,4,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                <Button Content="×" Padding="4,0" Margin="4,0,0,0" BorderThickness="0" Background="Transparent" ToolTip="移除"
                                                        Command="{Binding DataContext.RemoveAliasCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="加入" Padding="8,1" Margin="4,0,0,0"
                                        Command="{Binding DataContext.AddAliasCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.AutomationId="AddAlias" />
                                <TextBox Text="{Binding DataContext.NewAlias, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="NewAlias">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding DataContext.AddAliasCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                        </StackPanel>

                        <!-- 自訂屬性 -->
                        <TextBlock Text="自訂屬性（文字）" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding Props}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,2">
                                        <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Margin="4,0,0,0" ToolTip="移除"
                                                Command="{Binding DataContext.RemovePropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBox DockPanel.Dock="Left" Width="90" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock DockPanel.Dock="Left" Text="＝" VerticalAlignment="Center" Margin="2,0" />
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋ 新增屬性" HorizontalAlignment="Left" Padding="8,1"
                                Command="{Binding DataContext.AddPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <Button Content="刪除這個元素" HorizontalAlignment="Left" Padding="8,1" Margin="0,16,0,0" Foreground="#B00020"
                                Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.AutomationId="DeleteElement" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </TabItem>
            <TabItem Header="LOG 設定" AutomationProperties.AutomationId="LogSettingsTab">
                <!-- ADR-0002 第 7 點：建立案件時選擇廠別，匯入時使用這些設定 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="模組順序（一行一個）" FontWeight="SemiBold" />
                        <TextBlock Text="同一時間戳記的事件，依這個順序排列（不代表因果）。" Foreground="#777" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ModuleOrderText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalContentAlignment="Top" Height="70"
                                 VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" AutomationProperties.AutomationId="ModuleOrder" />

                        <TextBlock Text="已知 LOG 種類（Logger 名稱，一行一個）" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="不在清單中的 Logger 標示「未知種類」；清單空白時不標示。" Foreground="#777" TextWrapping="Wrap" />
                        <TextBox Text="{Binding KnownLoggersText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalContentAlignment="Top" Height="150"
                                 VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" AutomationProperties.AutomationId="KnownLoggers" />

                        <TextBlock Text="編碼" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="沒有指定的檔案自動判斷（有效的 UTF-8 就當 UTF-8，否則當 Big5）。模組空白表示所有模組。" Foreground="#777" TextWrapping="Wrap" />
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模組" Foreground="#555" />
                            <TextBlock Grid.Column="1" Text="Logger" Foreground="#555" />
                            <TextBlock Grid.Column="2" Text="編碼" Foreground="#555" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding EncodingRules}" AutomationProperties.AutomationId="EncodingRules">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Module, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Logger, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.EncodingChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Encoding}" />
                                        <Button Grid.Column="3" Content="×" Margin="2,0,0,0" ToolTip="移除"
                                                Command="{Binding DataContext.RemoveEncodingRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋ 新增編碼設定" HorizontalAlignment="Left" Padding="8,1" Margin="0,4,0,0"
                                Command="{Binding AddEncodingRuleCommand}" AutomationProperties.AutomationId="AddEncodingRule" />

                        <TextBlock Text="在席訊號" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="效果為 signal 的規則抽到這個訊號名稱時，決定站點的在席指示燈。" Foreground="#777" TextWrapping="Wrap" />
                        <TextBox Text="{Binding PresenceSignal, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,4,0,0" />

                        <!-- ADR-0005 第 3 點：站點模式代號的名稱 -->
                        <TextBlock Text="站點模式名稱" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="效果為 stationMode 的規則抽到的代號，回放時顯示為這裡的名稱；沒填的代號直接顯示。" Foreground="#777" TextWrapping="Wrap" />
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="代號" Foreground="#555" />
                            <TextBlock Grid.Column="1" Text="名稱" Foreground="#555" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding StationModeNames}" AutomationProperties.AutomationId="StationModeNames">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="×" Margin="2,0,0,0" ToolTip="移除"
                                                Command="{Binding DataContext.RemoveStationModeNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋ 新增站點模式名稱" HorizontalAlignment="Left" Padding="8,1" Margin="0,4,0,0"
                                Command="{Binding AddStationModeNameCommand}" AutomationProperties.AutomationId="AddStationModeName" />

                        <!-- ADR-0006、ADR-0008 第 3 點（#84）：沒有 LOG 的門檻 -->
                        <TextBlock Text="沒有 LOG 的門檻" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="同一模組超過這麼多秒沒有任何事件時，時間軸標示「這段時間沒有 LOG（可能是閒置或缺漏）」。模組從上方「模組順序」中選擇。沒有列出的模組為 300 秒；0 表示不標示。有心跳的模組可以設小一點。修改後，開啟案件時套用新版才生效。" Foreground="#777" TextWrapping="Wrap" />
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模組" Foreground="#555" />
                            <TextBlock Grid.Column="1" Text="秒數" Foreground="#555" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding GapThresholds}" AutomationProperties.AutomationId="GapThresholds">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding ModuleChoices}" SelectedItem="{Binding Module}" Margin="0,0,2,0"
                                                  AutomationProperties.AutomationId="GapThresholdModule" />
                                        <TextBox Grid.Column="1" Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="×" Margin="2,0,0,0" ToolTip="移除"
                                                Command="{Binding DataContext.RemoveGapThresholdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋ 新增門檻" HorizontalAlignment="Left" Padding="8,1" Margin="0,4,0,0"
                                Command="{Binding AddGapThresholdRowCommand}" AutomationProperties.AutomationId="AddGapThreshold" />

                        <!-- ADR-0005 第 8 點：解析欄位的抽取規則 -->
                        <TextBlock Text="解析規則" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Foreground="#777" TextWrapping="Wrap"
                                   Text="正規表示式；具名群組的名稱就是欄位，例如 (?&lt;station&gt;…)。可以用的欄位：station、vehicle、dock、storage、command、commandType、segment、source、destination、pallet、bin、signal、signalValue、stationMode、alarm、alarmCode、online、mode。模組、Logger 空白表示全部。「效果」表示這一行代表哪一種狀態變化（回放用）。修改後，新匯入的案件使用新規則。" />
                        <ItemsControl ItemsSource="{Binding ParseRules}" Margin="0,4,0,0" AutomationProperties.AutomationId="ParseRules">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" Padding="4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Margin="4,0,0,0" ToolTip="移除"
                                                        Command="{Binding DataContext.RemoveParseRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="模組" Foreground="#555" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBox Grid.Column="1" Text="{Binding Module, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Column="2" Text="Logger" Foreground="#555" VerticalAlignment="Center" Margin="6,0,4,0" />
                                                <TextBox Grid.Column="3" Text="{Binding Logger, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock Text="效果" Foreground="#555" VerticalAlignment="Center" Margin="0,0,4,0"
                                                           ToolTip="這一行 LOG 代表的狀態變化（世界模型）；空白表示只抽欄位" />
                                                <ComboBox ItemsSource="{Binding EffectChoices}" SelectedItem="{Binding Effect}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="＋ 新增規則" Padding="8,1" Command="{Binding NewParseRuleCommand}" AutomationProperties.AutomationId="NewParseRule" />
                            <Button Content="還原初始規則" Padding="8,1" Margin="6,0,0,0" Command="{Binding ResetParseRulesCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
