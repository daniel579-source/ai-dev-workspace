<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF 畫面：只做繫結與繪製（規格 #14「模組」第 3 點）。
       發佈方式見 README（ADR-0007：self-contained 單一資料夾，不用單一執行檔） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LogTrace</AssemblyName>
    <RootNamespace>LogTrace.App</RootNamespace>
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>zh-Hant;en</SatelliteResourceLanguages>
    <Version>0.5.0</Version>
  </PropertyGroup>

  <!-- 發佈資料夾附上使用說明、第三方元件清單與授權全文（#29） -->
  <ItemGroup>
    <None Include="..\..\docs\user-guide.md" Link="使用說明.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogTrace.Workspace\LogTrace.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.1" />
    <!-- 版面儲存與還原（ADR-0007：AvalonDock 5 的序列化在獨立套件） -->
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.1" />
    <!-- Layout 回放 3D（ADR-0017）：WebView2 內嵌 three.js -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- 3D 回放的網頁與 three.js（固定版本，放在程式內，不使用 CDN，ADR-0017 第 3 點） -->
  <ItemGroup>
    <None Include="Playback3D\**\*" Link="playback3d\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    WebView2 固定版本 Runtime（ADR-0017 第 2 點）：隨程式資料夾打包到 WebView2Runtime\，程式只使用這一份。
    Runtime 很大（約 680 MB），不放進 repo：由 Microsoft 下載 .cab 後解開到 third_party\webview2\runtime\（見 README）。
    找不到時照常建置，3D 面板會顯示原因。
  -->
  <PropertyGroup>
    <WebView2RuntimeVersion>157.0.4341.60</WebView2RuntimeVersion>
    <WebView2RuntimeSource>$(MSBuildThisFileDirectory)..\..\third_party\webview2\runtime\Microsoft.WebView2.FixedVersionRuntime.$(WebView2RuntimeVersion).x64\</WebView2RuntimeSource>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(WebView2RuntimeSource)')">
    <None Include="$(WebView2RuntimeSource)**\*" Link="WebView2Runtime\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
