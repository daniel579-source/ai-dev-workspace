<Window x:Class="LogTrace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:local="clr-namespace:LogTrace.App"
        xmlns:vm="clr-namespace:LogTrace.Workspace;assembly=LogTrace.Workspace"
        xmlns:pb="clr-namespace:LogTrace.Workspace.Playback;assembly=LogTrace.Workspace"
        Title="LogTrace" Width="1480" Height="860" Activated="Window_Activated" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.AutomationId="MainWindow">
    <Window.Resources>
        <local:NotConverter x:Key="Not" />
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:CollapsedWhenTrueConverter x:Key="Collapsed" />
        <DataTemplate x:Key="Choice">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,1" />
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <!-- 頂端：版面選單；右側固定顯示時區與時間校正（ADR-0003 第 1、5 點、ADR-0008 第 4 點） -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                <TextBlock Text="{Binding TimeZoneText}" VerticalAlignment="Center" Foreground="#333"
                           ToolTip="LOG 沒有時區；畫面一律以廠別當地時間顯示（廠別設定的時區）" AutomationProperties.AutomationId="TimeZone" />
                <TextBlock Text="{Binding CorrectionText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#B35C00" FontWeight="Bold"
                           ToolTip="事件的時間已加上偏移量，排序也依校正後的時間；原始時間在詳細資訊中"
                           AutomationProperties.AutomationId="CorrectionText" />
                <Button Content="時間校正…" Command="{Binding EditTimeCorrectionCommand}" Padding="8,0" Margin="12,1,0,1"
                        ToolTip="設定案件整體與個別模組的時間偏移量" AutomationProperties.AutomationId="EditTimeCorrection" />
            </StackPanel>
        <Menu Background="Transparent">
            <MenuItem Header="版面(_V)" AutomationProperties.AutomationId="LayoutMenu">
                <MenuItem Header="回放（Layout 為主）" Click="PlaybackLayout_Click" AutomationProperties.AutomationId="LayoutPlayback" />
                <MenuItem Header="搜尋（事件清單為主）" Click="SearchLayout_Click" AutomationProperties.AutomationId="LayoutSearch" />
                <Separator />
                <MenuItem Header="還原預設版面" Click="ResetLayout_Click" AutomationProperties.AutomationId="LayoutReset" />
            </MenuItem>
        </Menu>
        </DockPanel>

        <!-- 建立案件與匯入 -->
        <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="新案件名稱" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Text="{Binding NewCaseName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="NewCaseName" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="2" Text="廠別" VerticalAlignment="Center" Margin="10,0,6,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding Plants}" SelectedItem="{Binding SelectedPlant}" DisplayMemberPath="Name"
                          ToolTip="匯入時使用這個廠別的模組順序、已知 LOG 種類與編碼設定；廠別設定在「Layout 編輯器」中建立"
                          AutomationProperties.AutomationId="PlantChoice" />
                <Button Grid.Column="4" Content="建立案件" Command="{Binding CreateCaseCommand}" Padding="10,2" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="CreateCase" />
                <TextBlock Grid.Column="6" Text="匯入 LOG" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="7" Text="{Binding ImportSource, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="資料夾、7z 或 zip（日期 → 模組的結構，可以包含多天）"
                         AutomationProperties.AutomationId="ImportSource" VerticalContentAlignment="Center" />
                <Button Grid.Column="8" Content="資料夾…" Command="{Binding BrowseImportFolderCommand}" Padding="10,2" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="BrowseImportFolder" />
                <Button Grid.Column="9" Content="壓縮檔…" Command="{Binding BrowseImportArchiveCommand}" Padding="10,2" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="BrowseImportArchive" />
                <Button Grid.Column="10" Content="匯入" Command="{Binding ImportCommand}" Padding="10,2" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="Import" />
                <Button Grid.Column="11" Content="Layout 編輯器…" Command="{Binding OpenLayoutEditorCommand}" Padding="10,2" Margin="24,0,0,0"
                        ToolTip="編輯廠別設定檔與倉儲的 Layout" AutomationProperties.AutomationId="OpenLayoutEditor" />
            </Grid>
        </Border>

        <!-- 廠別設定有新版時的提示（ADR-0006 第 8 點）：由使用者決定是否套用 -->
        <Border DockPanel.Dock="Top" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1" Padding="8,4"
                AutomationProperties.AutomationId="NewerPlantBar">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NewerPlantNotice}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="不套用" Command="{Binding DismissNewerPlantCommand}" Padding="10,1" Margin="6,0,0,0"
                        ToolTip="維持案件目前的設定（快照）" AutomationProperties.AutomationId="DismissNewerPlant" />
                <Button DockPanel.Dock="Right" Content="套用新版" Command="{Binding ApplyNewerPlantCommand}" Padding="10,1" FontWeight="SemiBold"
                        AutomationProperties.AutomationId="ApplyNewerPlant" />
                <TextBlock Text="{Binding NewerPlantNotice}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="NewerPlantNotice" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentCaseName, StringFormat=案件：{0}, TargetNullValue=尚未開啟案件}" />
            </StatusBarItem>
            <Separator />
            <!-- 需要等待的工作（匯入、開啟案件、搜尋、重新排序等）進行中：會動的進度條與經過秒數 -->
            <StatusBarItem Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="BusyIndicator">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="12" />
                    <TextBlock x:Name="BusyElapsed" Margin="6,0,0,0" AutomationProperties.AutomationId="BusyElapsed" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" AutomationProperties.AutomationId="Status" />
            </StatusBarItem>
        </StatusBar>

        <!-- 面板只在這裡宣告一次；排列方式（回放、搜尋兩種預設版面，或使用者保存的版面）由 DockLayouts 建立（ADR-0008 第 7 點） -->
        <ad:DockingManager x:Name="Dock">
            <ad:LayoutRoot>
                <ad:LayoutPanel>
                    <ad:LayoutAnchorablePane>
                        <ad:LayoutAnchorable ContentId="cases" Title="案件" CanClose="False">
                            <DockPanel Margin="6">
                                <!-- 存放位置（ADR-0011 第 3 點） -->
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="存放位置" Foreground="#555" />
                                    <DockPanel Margin="0,2,0,0">
                                        <Button DockPanel.Dock="Right" Content="變更…" Command="{Binding ChangeCasesRootCommand}" Padding="8,1" Margin="6,0,0,0"
                                                AutomationProperties.AutomationId="ChangeCasesRoot" />
                                        <TextBlock Text="{Binding CasesRoot}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CasesRoot}"
                                                   VerticalAlignment="Center" AutomationProperties.AutomationId="CasesRoot" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding CasesRootWarning}" TextWrapping="Wrap" Foreground="#B00020" Margin="0,4,0,0"
                                               AutomationProperties.AutomationId="CasesRootWarning">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CasesRootWarning}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 廠別設定的存放位置（ADR-0006 第 7 點，#57） -->
                                    <TextBlock Text="廠別設定位置" Foreground="#555" Margin="0,6,0,0" />
                                    <DockPanel Margin="0,2,0,0">
                                        <Button DockPanel.Dock="Right" Content="變更…" Command="{Binding ChangePlantsRootCommand}" Padding="8,1" Margin="6,0,0,0"
                                                AutomationProperties.AutomationId="ChangePlantsRoot" />
                                        <TextBlock Text="{Binding PlantsRoot}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PlantsRoot}"
                                                   VerticalAlignment="Center" AutomationProperties.AutomationId="PlantsRoot" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding PlantsRootWarning}" TextWrapping="Wrap" Foreground="#B00020" Margin="0,4,0,0"
                                               AutomationProperties.AutomationId="PlantsRootWarning">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlantsRootWarning}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <!-- 目前的案件 -->
                                <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentCaseName, StringFormat=開啟中：{0}, TargetNullValue=沒有開啟的案件}"
                                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="CurrentCase" />
                                        <TextBlock Text="{Binding CurrentCasePlant, StringFormat=廠別：{0}, TargetNullValue=''}" Foreground="#555"
                                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="CurrentCasePlant" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="關閉案件" Command="{Binding CloseCaseCommand}" Padding="8,1"
                                                    ToolTip="關閉後就可以複製案件資料夾作為備份" AutomationProperties.AutomationId="CloseCase" />
                                            <Button Content="在檔案總管開啟" Command="{Binding OpenCaseFolderCommand}" Padding="8,1" Margin="6,0,0,0"
                                                    AutomationProperties.AutomationId="OpenCaseFolder" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="開啟" Command="{Binding OpenSelectedCaseCommand}" Padding="10,1"
                                            AutomationProperties.AutomationId="OpenSelectedCase" />
                                    <Button Content="刪除案件…" Command="{Binding DeleteSelectedCaseCommand}" Padding="8,1" Margin="6,0,0,0"
                                            AutomationProperties.AutomationId="DeleteSelectedCase" />
                                </StackPanel>
                                <!-- 案件清單：最近使用的在前 -->
                                <ListBox ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" Margin="0,8,0,0"
                                         AutomationProperties.AutomationId="CaseList" MouseDoubleClick="CaseList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PlantName}" Foreground="#777" FontSize="11" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat=建立 {0}}" Foreground="#777" FontSize="11" />
                                                    <TextBlock Text="・最近使用" Foreground="#2A6CB0" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecent}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable ContentId="search" Title="搜尋" CanClose="False">
                            <!-- ADR-0010：三個輸入框、篩選條件；按「搜尋」才查詢 -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="6">
                                    <StackPanel.Resources>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Margin" Value="0,1,0,4" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="全部包含" />
                                    <TextBox Text="{Binding SearchAllOf, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SearchAllOf"
                                             ToolTip="以空白分隔；包含空白的片語用雙引號，例如 &quot;door open&quot;">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="任一包含" />
                                    <TextBox Text="{Binding SearchAnyOf, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SearchAnyOf">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Text="不包含" />
                                    <TextBox Text="{Binding SearchNoneOf, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SearchNoneOf">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <CheckBox Content="區分大小寫（全形與半形仍視為相同）" IsChecked="{Binding SearchCaseSensitive}" Margin="0,0,0,2" />
                                    <CheckBox Content="正規表示式（進階）" IsChecked="{Binding SearchRegex}" Margin="0,0,0,6"
                                              AutomationProperties.AutomationId="SearchRegex"
                                              ToolTip="三個輸入框中的每個關鍵字都是 .NET 正規表示式，比對整筆事件內容；一律以掃描搜尋，可以取消" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="搜尋" Command="{Binding SearchCommand}" Padding="16,2" FontWeight="SemiBold"
                                                AutomationProperties.AutomationId="Search" />
                                        <Button Content="清除" Command="{Binding ClearSearchCommand}" Padding="8,2" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <!-- 搜尋中：進度與取消（ADR-0010 第 2 點） -->
                                    <DockPanel Margin="0,6,0,0" Visibility="{Binding IsSearching, Converter={StaticResource Visible}}">
                                        <Button DockPanel.Dock="Right" Content="取消" Command="{Binding CancelSearchCommand}" Padding="8,0" Margin="6,0,0,0"
                                                AutomationProperties.AutomationId="CancelSearch" />
                                        <ProgressBar Value="{Binding SearchProgress, Mode=OneWay}" Maximum="1" Height="14" AutomationProperties.AutomationId="SearchProgress" />
                                    </DockPanel>
                                    <TextBlock Text="最近的搜尋" Margin="0,8,0,0" />
                                    <ComboBox ItemsSource="{Binding RecentSearches}" SelectedItem="{Binding SelectedRecentSearch}" DisplayMemberPath="Label"
                                              AutomationProperties.AutomationId="RecentSearches" ToolTip="選擇後把條件填回，按「搜尋」才查詢" />

                                    <Expander Header="篩選條件（所有條件為 AND）" Margin="0,10,0,0" IsExpanded="False" AutomationProperties.AutomationId="SearchFilters">
                                        <StackPanel Margin="0,4,0,0">
                                            <TextBlock Text="時間（yyyy-MM-dd HH:mm:ss，空白表示不限）" TextWrapping="Wrap" Foreground="#555" />
                                            <DockPanel>
                                                <TextBlock Text="從" Width="24" VerticalAlignment="Center" />
                                                <TextBox Text="{Binding SearchFrom, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="到" Width="24" VerticalAlignment="Center" />
                                                <TextBox Text="{Binding SearchTo, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <TextBlock Text="解析欄位" Foreground="#555" Margin="0,4,0,0" />
                                            <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label"
                                                      AutomationProperties.AutomationId="FilterKind" />
                                            <ComboBox ItemsSource="{Binding ElementChoices}" SelectedItem="{Binding SelectedFilterElement}" DisplayMemberPath="Display"
                                                      Margin="0,2,0,0" AutomationProperties.AutomationId="FilterElement"
                                                      Visibility="{Binding IsElementFilter, Converter={StaticResource Visible}}"
                                                      ToolTip="案件所屬廠別的 Layout 中有別名的元素；比對元素的所有別名" />
                                            <TextBox Text="{Binding FilterValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
                                                     AutomationProperties.AutomationId="FilterValue"
                                                     Visibility="{Binding IsValueFilter, Converter={StaticResource Visible}}" />
                                            <TextBlock Text="模組" Foreground="#555" Margin="0,6,0,0" />
                                            <ItemsControl ItemsSource="{Binding ModuleChoices}" ItemTemplate="{StaticResource Choice}" />
                                            <TextBlock Text="等級" Foreground="#555" Margin="0,6,0,0" />
                                            <ItemsControl ItemsSource="{Binding LevelChoices}" ItemTemplate="{StaticResource Choice}" />
                                            <TextBlock Text="旗標（有任一個即符合）" Foreground="#555" Margin="0,6,0,0" />
                                            <ItemsControl ItemsSource="{Binding FlagChoices}" ItemTemplate="{StaticResource Choice}" />
                                            <TextBlock Text="Logger" Foreground="#555" Margin="0,6,0,0" />
                                            <ItemsControl ItemsSource="{Binding LoggerChoices}" ItemTemplate="{StaticResource Choice}" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- 全文索引（ADR-0011）：背景建立，尚未建好的日期以掃描搜尋 -->
                                    <TextBlock Text="{Binding IndexStatus}" TextWrapping="Wrap" Foreground="#555" Margin="0,12,0,2"
                                               AutomationProperties.AutomationId="IndexStatus" />
                                    <Button Content="重建全文索引" Command="{Binding RebuildIndexCommand}" HorizontalAlignment="Left" Padding="8,1"
                                            ToolTip="刪除全文索引並重新建立（索引是可以重建的資料；搜尋結果不受影響）"
                                            AutomationProperties.AutomationId="RebuildIndex" />
                                </StackPanel>
                            </ScrollViewer>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable ContentId="events" Title="事件清單" CanClose="False">
                            <DockPanel>
                                <!-- 檢視切換與旗標圖例（ADR-0008 第 5 點） -->
                                <Border DockPanel.Dock="Top" Padding="6,4" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <RadioButton Content="混合檢視" IsChecked="{Binding IsTrackView, Converter={StaticResource Not}}" Margin="0,0,10,0"
                                                         AutomationProperties.AutomationId="MixedView" />
                                            <RadioButton Content="分軌檢視" IsChecked="{Binding IsTrackView}" Margin="0,0,20,0"
                                                         AutomationProperties.AutomationId="TrackView" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding FlagLegend}" AutomationProperties.AutomationId="FlagLegend">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="{Binding Description}" Background="Transparent">
                                                        <TextBlock Text="{Binding Glyph}" Foreground="#B35C00" FontWeight="Bold" Margin="0,0,3,0" />
                                                        <TextBlock Text="{Binding Name}" Foreground="#555" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                                <!-- 搜尋結果（ADR-0010 第 4 點）：條件在左側「搜尋」面板 -->
                                <Border DockPanel.Dock="Top" Padding="6,4" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding SearchStatus, TargetNullValue=沒有搜尋（顯示全部事件）}" VerticalAlignment="Center" Foreground="#2A6CB0"
                                                   Margin="0,0,12,0" AutomationProperties.AutomationId="SearchStatus" />
                                        <RadioButton Content="只顯示符合的" IsChecked="{Binding ShowAllWithMarks, Converter={StaticResource Not}}" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" AutomationProperties.AutomationId="ShowMatchesOnly" />
                                        <RadioButton Content="顯示全部並標示符合的" IsChecked="{Binding ShowAllWithMarks}" Margin="0,0,12,0"
                                                     VerticalAlignment="Center" AutomationProperties.AutomationId="ShowAllWithMarks" />
                                        <Button Content="◀ 上一筆符合" Command="{Binding PreviousMatchCommand}" Padding="6,0" ToolTip="Ctrl＋←" />
                                        <Button Content="下一筆符合 ▶" Command="{Binding NextMatchCommand}" Padding="6,0" Margin="4,0,0,0" ToolTip="Ctrl＋→"
                                                AutomationProperties.AutomationId="NextMatch" />
                                        <Button Content="清除搜尋" Command="{Binding ClearSearchCommand}" Padding="6,0" Margin="8,0,0,0"
                                                AutomationProperties.AutomationId="ClearSearch" />
                                    </WrapPanel>
                                </Border>
                                <!-- ADR-0007 技術驗證：ListView＋GridView、固定列高。View 由 MainWindow.xaml.cs 依混合／分軌切換 -->
                                <ListView x:Name="EventList" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                                          AutomationProperties.AutomationId="EventList"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Item">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Height" Value="22" />
                                            <!-- 以底色區分模組（依模組順序） -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModuleIndex}" Value="0">
                                                    <Setter Property="Background" Value="#EEF4FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ModuleIndex}" Value="1">
                                                    <Setter Property="Background" Value="#EFFAF0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ModuleIndex}" Value="2">
                                                    <Setter Property="Background" Value="#FFF6E8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ModuleIndex}" Value="3">
                                                    <Setter Property="Background" Value="#F6EEFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </DockPanel>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable ContentId="playback" Title="Layout 回放" CanClose="False">
                            <!-- ADR-0008 第 6 點：依目前時刻（事件清單選取的事件）顯示世界狀態（ADR-0005） -->
                            <DockPanel DataContext="{Binding Playback}">
                                <Border DockPanel.Dock="Top" Padding="6,4" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MomentText, StringFormat=目前時刻：{0}}" AutomationProperties.AutomationId="PlaybackMoment" />
                                        <WrapPanel Margin="0,3,0,0">
                                            <Border Background="#E5E7EB" BorderBrush="#9CA3AF" BorderThickness="1" Width="14" Height="10" Margin="0,0,3,0" /><TextBlock Text="未知" Margin="0,0,10,0" Foreground="#555" />
                                            <Border Background="White" BorderBrush="#9CA3AF" BorderThickness="1" Width="14" Height="10" Margin="0,0,3,0" /><TextBlock Text="空" Margin="0,0,10,0" Foreground="#555" />
                                            <Border Background="#BFDBFE" BorderBrush="#9CA3AF" BorderThickness="1" Width="14" Height="10" Margin="0,0,3,0" /><TextBlock Text="有貨" Margin="0,0,10,0" Foreground="#555" />
                                            <Border Background="#FDE68A" BorderBrush="#9CA3AF" BorderThickness="1" Width="14" Height="10" Margin="0,0,3,0" /><TextBlock Text="搬送機執行中" Margin="0,0,10,0" Foreground="#555" />
                                            <Border Background="#FCA5A5" BorderBrush="#DC2626" BorderThickness="1" Width="14" Height="10" Margin="0,0,3,0" /><TextBlock Text="異常中" Margin="0,0,10,0" Foreground="#555" />
                                            <Border Background="#86EFAC" BorderBrush="#16A34A" BorderThickness="1" Width="14" Height="10" Margin="0,0,3,0" /><TextBlock Text="防火門開" Margin="0,0,10,0" Foreground="#555" />
                                            <Border Background="#F87171" BorderBrush="#B91C1C" BorderThickness="1" Width="14" Height="10" Margin="0,0,3,0" /><TextBlock Text="防火門關" Margin="0,0,10,0" Foreground="#555" />
                                            <TextBlock Text="在席燈：綠＝ON、深灰＝OFF、淡灰＝未知　⚠ 不一致　半透明＝推估" Foreground="#555" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Message}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,3,0,0" AutomationProperties.AutomationId="PlaybackMessage">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- FR-037（#84）：目前時刻落在某些模組沒有 LOG 的時段 -->
                                        <TextBlock Text="{Binding GapNotice}" Foreground="#475569" Background="#F1F5F9" Padding="4,1" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   AutomationProperties.AutomationId="PlaybackGapNotice">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GapNotice}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <!-- 3D（ADR-0017）：WebView2 + three.js；樓層一律上下堆疊 -->
                                <local:Playback3DView x:Name="Playback3D" />
                            </DockPanel>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable ContentId="timeline" Title="時間軸" CanClose="False">
                            <!-- ADR-0008 第 1～3 點：方向鍵、播放、時間軸總覽與細部 -->
                            <DockPanel Margin="4,2">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Button Content="⏮" Command="{Binding GoToStartCommand}" ToolTip="案件開頭（Home）" Padding="6,0" />
                                    <Button Content="◀" Command="{Binding PreviousChangeCommand}" ToolTip="上一個狀態變化（←）；Shift＋← 上一筆事件" Padding="6,0" Margin="2,0" />
                                    <Button Command="{Binding TogglePlayCommand}" Padding="10,0" AutomationProperties.AutomationId="TogglePlay" ToolTip="播放／暫停（空白鍵）">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="▶ 播放" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Content" Value="⏸ 暫停" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="▶" Command="{Binding NextChangeCommand}" ToolTip="下一個狀態變化（→）；Shift＋→ 下一筆事件" Padding="6,0" Margin="2,0" />
                                    <Button Content="⏭" Command="{Binding GoToEndCommand}" ToolTip="案件結尾（End）" Padding="6,0" />
                                    <TextBlock Text="速度 ×" VerticalAlignment="Center" Margin="12,0,2,0" />
                                    <ComboBox ItemsSource="{Binding Source={x:Static vm:MainViewModel.Speeds}}" SelectedItem="{Binding Speed}" Width="50"
                                              AutomationProperties.AutomationId="Speed" />
                                    <CheckBox Content="略過閒置時段（10 秒以上沒有狀態變化）" IsChecked="{Binding SkipIdle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding CurrentTimeText, StringFormat=目前時刻：{0}}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="CurrentTime" />
                                    <TextBlock Text="　紅＝警報期間　黃＝搜尋符合　橘＝時間不確定　灰斜線＝模組沒有 LOG" VerticalAlignment="Center" Foreground="#777" />
                                </StackPanel>
                                <local:TimelineCanvas x:Name="DetailTimeline" DockPanel.Dock="Bottom" Height="30" Margin="0,2,0,0" IsDetail="True"
                                                      Timeline="{Binding Timeline}" ToolTip="細部：目前時刻前後 30 秒；長刻度＝狀態變化，顏色＝模組"
                                                      AutomationProperties.AutomationId="DetailTimeline" />
                                <local:TimelineCanvas x:Name="OverviewTimeline" Margin="0,3,0,0" Timeline="{Binding Timeline}"
                                                      ToolTip="總覽：點擊或拖曳跳到該時刻" AutomationProperties.AutomationId="OverviewTimeline" />
                            </DockPanel>
                        </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="detail" Title="詳細資訊" CanClose="False">
                                <DockPanel>
                                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="4,2" Padding="6,0" Command="{Binding ToggleRevealCommand}"
                                            Visibility="{Binding SelectedHasMasked, Converter={StaticResource Visible}}"
                                            AutomationProperties.AutomationId="ToggleReveal" ToolTip="電話號碼預設遮罩（ADR-0009）；換一筆事件後恢復遮罩">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="顯示完整電話號碼" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RevealSensitive}" Value="True">
                                                        <Setter Property="Content" Value="遮罩電話號碼" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <RichTextBox IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft JhengHei UI" BorderThickness="0"
                                                 local:Highlight.Segments="{Binding SelectedDetailSegments}" IsDocumentEnabled="True"
                                                 AutomationProperties.AutomationId="EventDetail" />
                                </DockPanel>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="elementstate" Title="元素狀態" CanClose="False">
                                <!-- 選取元素的目前狀態，每一列附上造成它的事件；料架顯示側視圖 -->
                                <DockPanel DataContext="{Binding Playback}">
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button DockPanel.Dock="Right" Content="只看這個元素" Padding="6,0" Margin="4,2"
                                                Command="{Binding DataContext.FocusSelectedElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                IsEnabled="{Binding HasSelection}" AutomationProperties.AutomationId="FocusElement"
                                                ToolTip="事件清單只列出與這個元素（含所有別名）相關的事件，方向鍵也只在其中移動；以「清除搜尋」恢復" />
                                        <TextBlock Padding="6,3" FontWeight="SemiBold" AutomationProperties.AutomationId="ElementStateTitle"
                                                   Text="{Binding SelectedElement.Name, TargetNullValue=點選 Layout 上的元素}" />
                                    </DockPanel>
                                    <ListView DockPanel.Dock="Top" ItemsSource="{Binding Detail}" BorderThickness="0" MaxHeight="220"
                                              AutomationProperties.AutomationId="ElementState">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="狀態" DisplayMemberBinding="{Binding Label}" Width="70" />
                                                <GridViewColumn Header="值" Width="180">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="造成這個狀態的事件" Width="300">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding CauseText}">
                                                                <Hyperlink Command="{Binding DataContext.Playback.GoToCauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           CommandParameter="{Binding Cause}">
                                                                    <Run Text="{Binding CauseText, Mode=OneWay}" />
                                                                </Hyperlink>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding SideViewTitle}" Padding="6,6,6,2" FontWeight="SemiBold" />
                                    <ListView ItemsSource="{Binding SideView}" BorderThickness="0" AutomationProperties.AutomationId="RackSideView">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="層" DisplayMemberBinding="{Binding Level}" Width="40" />
                                                <GridViewColumn Header="儲位" DisplayMemberBinding="{Binding StorageCode}" Width="80" />
                                                <GridViewColumn Header="棧板" DisplayMemberBinding="{Binding Content}" Width="110" />
                                                <GridViewColumn Header="造成這個狀態的事件" Width="260">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding CauseText}">
                                                                <Hyperlink Command="{Binding DataContext.Playback.GoToCauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           CommandParameter="{Binding Cause}">
                                                                    <Run Text="{Binding CauseText, Mode=OneWay}" />
                                                                </Hyperlink>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="commands" Title="命令" CanClose="False">
                                <!-- ADR-0008 第 6 點：每個命令目前的狀態與到案件結束時的狀態；選一個命令列出串起來的事件 -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ListView ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}" BorderThickness="0"
                                              AutomationProperties.AutomationId="CommandList">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="命令" DisplayMemberBinding="{Binding Id}" Width="80" />
                                                <GridViewColumn Header="事件" DisplayMemberBinding="{Binding EventCount}" Width="40" />
                                                <GridViewColumn Header="目前時刻" DisplayMemberBinding="{Binding CurrentStatus}" Width="180" />
                                                <GridViewColumn Header="案件結束時" DisplayMemberBinding="{Binding FinalStatus}" Width="200" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock Grid.Row="1" Text="{Binding SelectedCommand.Id, StringFormat=命令 {0} 串起來的事件（點一筆跳到該時刻）, TargetNullValue=選一個命令，列出串起來的所有事件}"
                                               Padding="6,3" Foreground="#555" />
                                    <ListView x:Name="CommandEventList" Grid.Row="2" ItemsSource="{Binding CommandEvents}" BorderThickness="0"
                                              SelectionChanged="CommandEventList_SelectionChanged" AutomationProperties.AutomationId="CommandEvents">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="時間" DisplayMemberBinding="{Binding Time}" Width="150" />
                                                <GridViewColumn Header="模組" DisplayMemberBinding="{Binding Module}" Width="50" />
                                                <GridViewColumn Header="訊息" DisplayMemberBinding="{Binding Message}" Width="320" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="equipment" Title="設備狀態表" CanClose="False">
                                <!-- ADR-0008 第 6 點：所有站點、搬送機、對接設備在目前時刻的狀態；可排序，可以只看異常中或不一致 -->
                                <DockPanel DataContext="{Binding Playback}">
                                    <CheckBox DockPanel.Dock="Top" Content="只看異常中或不一致" IsChecked="{Binding OnlyAbnormal}" Margin="6,4"
                                              AutomationProperties.AutomationId="OnlyAbnormal" />
                                    <ListView ItemsSource="{Binding Equipment}" SelectedItem="{Binding SelectedEquipment}" BorderThickness="0" AutomationProperties.AutomationId="EquipmentTable">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAbnormal}" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn DisplayMemberBinding="{Binding Name}" Width="90">
                                                    <GridViewColumn.Header>
                                                        <Button Content="名稱" Command="{Binding DataContext.SortEquipmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{x:Static pb:EquipmentSort.Name}" BorderThickness="0" Background="Transparent" />
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>
                                                <GridViewColumn DisplayMemberBinding="{Binding TypeLabel}" Width="70">
                                                    <GridViewColumn.Header>
                                                        <Button Content="種類" Command="{Binding DataContext.SortEquipmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{x:Static pb:EquipmentSort.Type}" BorderThickness="0" Background="Transparent" />
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>
                                                <!-- ADR-0006 第 13 點：所在樓層 -->
                                                <GridViewColumn Header="樓層" DisplayMemberBinding="{Binding Floor}" Width="50" />
                                                <GridViewColumn Width="60">
                                                    <GridViewColumn.Header>
                                                        <Button Content="異常" Command="{Binding DataContext.SortEquipmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{x:Static pb:EquipmentSort.Abnormal}" BorderThickness="0" Background="Transparent" />
                                                    </GridViewColumn.Header>
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock x:Name="Mark" Text="" Foreground="#B91C1C" FontWeight="Bold" />
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsAbnormal}" Value="True">
                                                                    <Setter TargetName="Mark" Property="Text" Value="⚠" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn DisplayMemberBinding="{Binding State}" Width="320">
                                                    <GridViewColumn.Header>
                                                        <Button Content="狀態" Command="{Binding DataContext.SortEquipmentCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                CommandParameter="{x:Static pb:EquipmentSort.State}" BorderThickness="0" Background="Transparent" />
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>
                                                <GridViewColumn Header="別名" DisplayMemberBinding="{Binding Aliases}" Width="100" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="unmapped" Title="未對應" CanClose="False">
                                <!-- 目前時刻前後 30 秒內出現、但 Layout 沒有對應元素的編號 -->
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="目前時刻前後 30 秒內出現、但 Layout 沒有對應元素的編號；可以在 Layout 編輯器中拖到元素上成為別名。"
                                               TextWrapping="Wrap" Foreground="#555" Padding="6,3" />
                                    <ListView ItemsSource="{Binding UnmappedNearby}" BorderThickness="0" AutomationProperties.AutomationId="UnmappedNearby">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="編號" DisplayMemberBinding="{Binding Value}" Width="100" />
                                                <GridViewColumn Header="種類" DisplayMemberBinding="{Binding KindLabel}" Width="70" />
                                                <GridViewColumn Header="附近" DisplayMemberBinding="{Binding NearbyCount}" Width="50" />
                                                <GridViewColumn Header="案件中" DisplayMemberBinding="{Binding TotalCount}" Width="60" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="knowledge" Title="知識庫" CanClose="False">
                                <!-- ADR-0013 第 2 點：廠別的知識庫（<廠別設定檔名>.kb.csv），以關鍵字搜尋；警報代碼對到的說明另外顯示在詳細資訊 -->
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="4,2">
                                        <Button DockPanel.Dock="Right" Content="重新載入" Padding="6,0" Margin="4,0,0,0" Command="{Binding ReloadKnowledgeCommand}"
                                                AutomationProperties.AutomationId="ReloadKnowledge" ToolTip="修改知識庫檔後重新讀取" />
                                        <Button DockPanel.Dock="Right" Content="搜尋" Padding="6,0" Margin="4,0,0,0" Command="{Binding SearchKnowledgeCommand}"
                                                AutomationProperties.AutomationId="SearchKnowledge" />
                                        <TextBox Text="{Binding KnowledgeQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="KnowledgeQuery"
                                                 ToolTip="以空白分隔的關鍵字，每個都要包含；比對代碼、說明、處置、出處，不分大小寫、全形與半形相同">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SearchKnowledgeCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding KnowledgeStatus}" TextWrapping="Wrap" Foreground="#555" Padding="6,1"
                                               AutomationProperties.AutomationId="KnowledgeStatus" />
                                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding KnowledgeIssues}" Foreground="#B00020" Margin="6,0"
                                                  AutomationProperties.AutomationId="KnowledgeIssues" />
                                    <ListView ItemsSource="{Binding KnowledgeResults}" BorderThickness="0" AutomationProperties.AutomationId="KnowledgeResults">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="代碼" DisplayMemberBinding="{Binding Code}" Width="70" />
                                                <GridViewColumn Header="說明" Width="240">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="處置" Width="200">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Action}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="出處" DisplayMemberBinding="{Binding Source}" Width="160" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="incidents" Title="異常紀錄" CanClose="False">
                                <!-- ADR-0016（#110）：異常紀錄（<廠別設定檔名>.incidents\）。查詢只列目前有效的版本；待審核清單含還不能審核的；停用後可以恢復 -->
                                <DockPanel DataContext="{Binding Incidents}">
                                    <WrapPanel DockPanel.Dock="Top" Margin="4,2">
                                        <TextBlock Text="使用者：" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Width="110" AutomationProperties.AutomationId="IncidentUser"
                                                 ToolTip="建立時的撰寫者、審核時的審核者（預設為 Windows 使用者名稱）" />
                                        <Button Content="從目前案件建立" Padding="6,0" Margin="6,0,0,0" Command="{Binding NewFromCaseCommand}"
                                                AutomationProperties.AutomationId="IncidentNewFromCase" ToolTip="建立草稿，帶入廠別、案件名稱與選取的事件" />
                                        <Button Content="整理維修紀錄" Padding="6,0" Margin="4,0,0,0" Command="{Binding NewMaintenanceCommand}"
                                                AutomationProperties.AutomationId="IncidentNewMaintenance" ToolTip="手動輸入過去維修紀錄的原文" />
                                        <Button Content="重新載入" Padding="6,0" Margin="4,0,0,0" Command="{Binding ReloadCommand}"
                                                AutomationProperties.AutomationId="IncidentReload" ToolTip="重新讀取異常紀錄資料夾（例如另一台電腦修改後）" />
                                    </WrapPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#555" Padding="6,1"
                                               AutomationProperties.AutomationId="IncidentStatus" />
                                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Issues}" Foreground="#B00020" Margin="6,0"
                                                  AutomationProperties.AutomationId="IncidentIssues" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <TabControl Grid.Column="0" AutomationProperties.AutomationId="IncidentTabs">
                                            <TabItem Header="查詢" AutomationProperties.AutomationId="IncidentSearchTab">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,2">
                                                        <Button DockPanel.Dock="Right" Content="搜尋" Padding="6,0" Margin="4,0,0,0" Command="{Binding SearchCommand}"
                                                                AutomationProperties.AutomationId="IncidentSearch" />
                                                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="IncidentQuery"
                                                                 ToolTip="以空白分隔的關鍵字，每個都要包含；只搜尋目前有效的版本（不含草稿與停用）">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                    </DockPanel>
                                                    <ListView ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" BorderThickness="0"
                                                              AutomationProperties.AutomationId="IncidentResults">
                                                        <ListView.View>
                                                            <GridView>
                                                                <GridViewColumn Header="現象" Width="200">
                                                                    <GridViewColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Symptom}" TextWrapping="Wrap" />
                                                                        </DataTemplate>
                                                                    </GridViewColumn.CellTemplate>
                                                                </GridViewColumn>
                                                                <GridViewColumn Header="版" DisplayMemberBinding="{Binding Rev}" Width="30" />
                                                                <GridViewColumn Header="狀態" DisplayMemberBinding="{Binding Status}" Width="90" />
                                                                <GridViewColumn Header="最新一版的修改" Width="170">
                                                                    <GridViewColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Changed}" TextWrapping="Wrap" Foreground="#B35C00" FontWeight="Bold" />
                                                                        </DataTemplate>
                                                                    </GridViewColumn.CellTemplate>
                                                                </GridViewColumn>
                                                                <GridViewColumn Header="編號" DisplayMemberBinding="{Binding Id}" Width="170" />
                                                            </GridView>
                                                        </ListView.View>
                                                    </ListView>
                                                </DockPanel>
                                            </TabItem>
                                            <TabItem Header="待審核" AutomationProperties.AutomationId="IncidentQueueTab">
                                                <ListView ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueueItem}" BorderThickness="0"
                                                          AutomationProperties.AutomationId="IncidentQueue">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="種類" DisplayMemberBinding="{Binding Kind}" Width="70" />
                                                            <GridViewColumn Header="等待" DisplayMemberBinding="{Binding Waiting}" Width="80" />
                                                            <GridViewColumn Header="現象" Width="160">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Symptom}" TextWrapping="Wrap" />
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="擋下的原因" Width="170">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Blocks}" TextWrapping="Wrap" Foreground="#B00020" />
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="提醒" Width="150">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Foreground="#8A6D00" />
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="編號" DisplayMemberBinding="{Binding Id}" Width="170" />
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </TabItem>
                                            <TabItem Header="停用" AutomationProperties.AutomationId="IncidentDisabledTab">
                                                <ListView ItemsSource="{Binding Disabled}" SelectedItem="{Binding SelectedDisabled}" BorderThickness="0"
                                                          AutomationProperties.AutomationId="IncidentDisabled">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="現象" DisplayMemberBinding="{Binding Symptom}" Width="220" />
                                                            <GridViewColumn Header="版" DisplayMemberBinding="{Binding Rev}" Width="30" />
                                                            <GridViewColumn Header="編號" DisplayMemberBinding="{Binding Id}" Width="170" />
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </TabItem>
                                        </TabControl>
                                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="IncidentDetailArea">
                                            <StackPanel Margin="4">
                                                <ItemsControl ItemsSource="{Binding DetailLines}" AutomationProperties.AutomationId="IncidentDetail">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock x:Name="Line" Text="{Binding Text}" TextWrapping="Wrap" />
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                    <Setter TargetName="Line" Property="Background" Value="#FFE0B2" />
                                                                    <Setter TargetName="Line" Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Pending}" Value="True">
                                                                    <Setter TargetName="Line" Property="Background" Value="#E3F2FD" />
                                                                    <Setter TargetName="Line" Property="Foreground" Value="#0D47A1" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="相關事件（選取後可跳到事件；案件不在這台電腦時仍可閱讀保存的內容）" TextWrapping="Wrap" Margin="0,8,0,2" Foreground="#555" />
                                                <ListBox ItemsSource="{Binding RecordEvents}" SelectedItem="{Binding SelectedRecordEvent}" MaxHeight="140"
                                                         AutomationProperties.AutomationId="IncidentEvents">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock TextWrapping="Wrap">
                                                                <Run Text="{Binding Sequence, StringFormat='#{0}', Mode=OneWay}" />
                                                                <Run Text="{Binding Time, Mode=OneWay}" />
                                                                <Run Text="{Binding Module, Mode=OneWay}" />
                                                                <Run Text="{Binding Message, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <WrapPanel Margin="0,2">
                                                    <Button Content="跳到事件" Padding="6,0" Margin="0,0,4,2" Command="{Binding GoToEventCommand}" AutomationProperties.AutomationId="IncidentGoToEvent" />
                                                    <Button Content="加入選取的事件" Padding="6,0" Margin="0,0,4,2" Command="{Binding AddSelectedEventCommand}" AutomationProperties.AutomationId="IncidentAddEvent"
                                                            ToolTip="把事件清單中選取的事件加入紀錄（保存時間、模組與遮罩後的訊息）" />
                                                    <Button Content="移除事件" Padding="6,0" Margin="0,0,4,2" Command="{Binding RemoveEventCommand}" AutomationProperties.AutomationId="IncidentRemoveEvent" />
                                                </WrapPanel>
                                                <Expander Header="編輯（草稿或修訂中）" IsExpanded="{Binding IsEditing, Mode=OneWay}" IsEnabled="{Binding IsEditing}" Margin="0,6,0,0"
                                                          AutomationProperties.AutomationId="IncidentEditor">
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                        </Grid.RowDefinitions>
                                                        <Grid.Resources>
                                                            <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,2,6,2" /><Setter Property="VerticalAlignment" Value="Top" /></Style>
                                                            <Style TargetType="TextBox"><Setter Property="Margin" Value="0,2" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="AcceptsReturn" Value="True" /></Style>
                                                            <Style TargetType="CheckBox"><Setter Property="Margin" Value="6,4,0,0" /><Setter Property="Content" Value="AI 推測" /></Style>
                                                        </Grid.Resources>
                                                        <TextBlock Grid.Row="0" Text="現象" />
                                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditSymptom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="IncidentEditSymptom" />
                                                        <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding AiSymptom}" AutomationProperties.AutomationId="IncidentAiSymptom" ToolTip="取消勾選表示已確認" />
                                                        <TextBlock Grid.Row="1" Text="發生時間" />
                                                        <DockPanel Grid.Row="1" Grid.Column="1">
                                                            <TextBox Text="{Binding EditFrom, UpdateSourceTrigger=PropertyChanged}" Width="170" AcceptsReturn="False" AutomationProperties.AutomationId="IncidentEditFrom" />
                                                            <TextBlock Text=" ～ " Margin="2" />
                                                            <TextBox Text="{Binding EditTo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" AutomationProperties.AutomationId="IncidentEditTo" />
                                                        </DockPanel>
                                                        <TextBlock Grid.Row="2" Text="廠別" />
                                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditPlant, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" AutomationProperties.AutomationId="IncidentEditPlant" />
                                                        <TextBlock Grid.Row="3" Text="案件" />
                                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditCaseName, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" AutomationProperties.AutomationId="IncidentEditCase" />
                                                        <TextBlock Grid.Row="4" Text="警報代碼" />
                                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditAlarmCodes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" AutomationProperties.AutomationId="IncidentEditAlarms" ToolTip="以頓號、逗號或空白分隔" />
                                                        <TextBlock Grid.Row="5" Text="相關設備" />
                                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EditDevices, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" AutomationProperties.AutomationId="IncidentEditDevices" ToolTip="以頓號、逗號或空白分隔" />
                                                        <TextBlock Grid.Row="6" Text="停機時間" />
                                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditDowntime, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" AutomationProperties.AutomationId="IncidentEditDowntime" ToolTip="自由文字，例如「約 45 分鐘」" />
                                                        <TextBlock Grid.Row="7" Text="處理人" />
                                                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EditHandler, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" AutomationProperties.AutomationId="IncidentEditHandler" />
                                                        <TextBlock Grid.Row="8" Text="原因" />
                                                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding EditCause, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="IncidentEditCause" />
                                                        <CheckBox Grid.Row="8" Grid.Column="2" IsChecked="{Binding AiCause}" AutomationProperties.AutomationId="IncidentAiCause" ToolTip="取消勾選表示已確認" />
                                                        <TextBlock Grid.Row="9" Text="處置" />
                                                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding EditDisposal, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="IncidentEditDisposal" />
                                                        <CheckBox Grid.Row="9" Grid.Column="2" IsChecked="{Binding AiDisposal}" AutomationProperties.AutomationId="IncidentAiDisposal" ToolTip="取消勾選表示已確認" />
                                                        <TextBlock Grid.Row="10" Text="執行者" />
                                                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding EditExecutor, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" AutomationProperties.AutomationId="IncidentEditExecutor" ToolTip="處置由誰執行（ADR-0014 第 4 點），例如「第一線」「工程師」" />
                                                        <TextBlock Grid.Row="11" Text="結果" />
                                                        <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding EditResult, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="IncidentEditResult" />
                                                        <TextBlock Grid.Row="12" Grid.ColumnSpan="3" Text="{Binding CheckText}" TextWrapping="Wrap" Foreground="#8A1C00" AutomationProperties.AutomationId="IncidentCheck" />
                                                    </Grid>
                                                </Expander>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button Content="存檔" Padding="6,0" Margin="0,0,4,2" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="IncidentSave" />
                                                    <Button Content="審核通過" Padding="6,0" Margin="0,0,4,2" Command="{Binding ApproveCommand}" AutomationProperties.AutomationId="IncidentApprove" />
                                                    <Button Content="修訂" Padding="6,0" Margin="0,0,4,2" Command="{Binding ReviseCommand}" AutomationProperties.AutomationId="IncidentRevise"
                                                            ToolTip="修改已審核的紀錄；審核通過前查詢仍顯示目前的版本" />
                                                    <Button Content="放棄修改" Padding="6,0" Margin="0,0,4,2" Command="{Binding CancelReviseCommand}" AutomationProperties.AutomationId="IncidentCancelRevise" />
                                                    <Button Content="恢復" Padding="6,0" Margin="0,0,4,2" Command="{Binding RestoreCommand}" AutomationProperties.AutomationId="IncidentRestore"
                                                            ToolTip="退回草稿，重新審核通過後成為新的一版" />
                                                </WrapPanel>
                                                <DockPanel Margin="0,2">
                                                    <Button DockPanel.Dock="Right" Content="停用" Padding="6,0" Margin="4,0,0,0" Command="{Binding DisableCommand}" AutomationProperties.AutomationId="IncidentDisable" />
                                                    <TextBlock Text="停用理由：" VerticalAlignment="Center" />
                                                    <TextBox Text="{Binding DisableReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="IncidentDisableReason" />
                                                </DockPanel>
                                                <Expander Header="修訂經過" Margin="0,6,0,0" AutomationProperties.AutomationId="IncidentHistory">
                                                    <TextBox Text="{Binding HistoryText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                             AutomationProperties.AutomationId="IncidentHistoryText" />
                                                </Expander>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                            <ad:LayoutAnchorable ContentId="rawlog" Title="原始 LOG" CanClose="False">
                                <!-- ADR-0008 第 6 點：依原始行序顯示選取事件所在的檔案，標出該事件的行 -->
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding RawFile}" Padding="6,3" Foreground="#555"
                                               AutomationProperties.AutomationId="RawFile" />
                                    <ListBox x:Name="RawLog" ItemsSource="{Binding RawLines}" SelectedItem="{Binding RawSelectedLine, Mode=OneWay}"
                                             FontFamily="Consolas, Microsoft JhengHei UI" BorderThickness="0"
                                             AutomationProperties.AutomationId="RawLog"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InSelectedEvent}" Value="True">
                                                        <Setter Property="Background" Value="#FFF3B0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding LineNo}" Width="56" TextAlignment="Right" Foreground="#999" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding Text}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>

        </ad:DockingManager>
    </DockPanel>
</Window>
