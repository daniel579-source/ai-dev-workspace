<Project>
  <!-- 各測試專案共用：把虛構 LOG 複製到輸出資料夾的 fixtures\ 下 -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)fixtures\**\*.txt;$(MSBuildThisFileDirectory)fixtures\*.zip;$(MSBuildThisFileDirectory)fixtures\*.7z"
          LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport\*.cs" LinkBase="TestSupport" />
  </ItemGroup>
</Project>
